# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public card URLs
# Production share link (QR, NFC, WhatsApp) — always hexacards.com
NEXT_PUBLIC_CANONICAL_SITE_URL=https://hexacards.com
# Optional override for local dev only; Vercel preview auto-detects *.vercel.app
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — card profile/background image bucket (default: card-images)
# Server-only; client uses the same default. Create bucket in Supabase (sql/card-images-storage.sql)
CARD_IMAGES_BUCKET=card-images

# Optional — leave unset on Vercel so /api routes use same origin
# NEXT_PUBLIC_API_URL=

# reCAPTCHA v2 (production — get keys at https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Razorpay (Dashboard → Account & Settings → API Keys)
# Required on Vercel for checkout — both must be set or payment shows "Razorpay keys are not configured"
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OTP login — Nimbus SMS (https://nimbusit.biz)
# Real SMS is used when OTP_SMS_ENABLED=true (or when all Nimbus vars below are set).
OTP_SMS_ENABLED=true
NIMBUS_SMS_USER_ID=hexabiz
NIMBUS_SMS_PASSWORD=your_nimbus_password
NIMBUS_SMS_SENDER_ID=HEXACR
NIMBUS_SMS_ENTITY_ID=1701178799996228439
NIMBUS_SMS_TEMPLATE_ID=1777178824647145094
# Optional — defaults to https://nimbusit.biz/api/SmsApi/SendSingleApi
# NIMBUS_SMS_API_URL=https://nimbusit.biz/api/SmsApi/SendSingleApi
