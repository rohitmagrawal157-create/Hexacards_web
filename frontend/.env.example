# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — card profile/background image bucket (default: card-images)
# CARD_IMAGES_BUCKET=card-images

# Optional — leave unset on Vercel so /api routes use same origin
# NEXT_PUBLIC_API_URL=

# reCAPTCHA v2 (production — get keys at https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Razorpay (Dashboard → Account & Settings → API Keys)
# Required on Vercel for checkout — both must be set or payment shows "Razorpay keys are not configured"
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
